rules_version = '2';
// SingLearn – Firebase Storage rules: song media (audio, LRC, covers) is
// readable by signed-in users and writable only by content admins.
service firebase.storage {
  match /b/{bucket}/o {
    match /songs/{songId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
