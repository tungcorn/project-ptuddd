rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/documents/{documentId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function valid(data) {
        return data.keys().hasAll(['ownerId', 'title', 'subject', 'note', 'fileName',
            'contentType', 'size', 'storagePath', 'createdAt'])
          && data.keys().hasOnly(['ownerId', 'title', 'subject', 'note', 'fileName',
            'contentType', 'size', 'storagePath', 'createdAt'])
          && data.ownerId == uid
          && data.title is string && data.title.size() > 0 && data.title.size() <= 250
          && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 120
          && data.note is string && data.note.size() <= 4000
          && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255
          && data.contentType in ['application/pdf', 'text/plain', 'application/zip',
            'image/png', 'image/jpeg',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.openxmlformats-officedocument.presentationml.presentation',
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet']
          && data.size is int && data.size > 0 && data.size <= 10 * 1024 * 1024
          && data.storagePath == 'users/' + uid + '/documents/' + documentId + '/file'
          && data.createdAt is timestamp;
      }
      allow read, delete: if owner();
      allow create: if owner() && valid(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if owner() && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'note']);
    }
  }
}
