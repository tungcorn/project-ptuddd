rules_version = '2';
// SingLearn – Cloud Firestore security rules (section 4.2 / 8 of the outline).
// - Every learner reads/writes only their own data under users/{uid}.
// - Songs are readable by signed-in users; only content admins (custom claim
//   `admin: true`) may create/update them.
// - Public profiles are readable by signed-in users (friend search,
//   leaderboard); each user writes only their own.
// - Friendships/challenges are readable and writable only by their members.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /songs/{songId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isSelf(uid);
      match /{sub=**} {
        allow read, write: if isSelf(uid);
      }
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.requestedBy == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2;
      // Only the invited member may accept; either member may delete.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /challenges/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'waiting';
      // The receiver submits their score once.
      allow update: if signedIn()
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'waiting'
        && request.resource.data.fromScore == resource.data.fromScore
        && request.resource.data.questions == resource.data.questions;
    }
  }
}
